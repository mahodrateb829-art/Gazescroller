name: Build APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Debug — list repo contents
        run: |
          echo "محتويات الـ repo:"
          ls -la

      - name: Extract project
        run: |
          if [ -f GazeScroller-android-project.zip ]; then
            unzip -o GazeScroller-android-project.zip -d .
            echo "تم الفك بنجاح، محتويات بعد الفك:"
            ls -la
          else
            echo "❌ ما لقيت GazeScroller-android-project.zip بجذر الـ repo!"
            echo "الملفات الموجودة فعليًا:"
            ls -la
            exit 1
          fi

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Build debug APK
        working-directory: GazeScroller
        run: gradle assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: app-debug-apk
          path: GazeScroller/app/build/outputs/apk/debug/app-debug.apk
